function isDataValid(path) {
    var sanitizedPath;
    sanitizedPath = window.intel.DOMPurify.sanitize(path);
    return sanitizedPath;
}
'use strict';
var intel = intel || {};
var chatConfigObj = chatConfigObj || {};

intel.chatConstants = {

    CID: chatConfigObj.virtualAssistantUid ? chatConfigObj.virtualAssistantUid : '',
    EMPTY: '',
    HIDE: 'hide',
    TRUE: 'true',
    FALSE: 'false',
    UNDEFINED: 'undefined',
    NA: 'NA',
    LOCALE: 'locale',
    APP: 'app',
    COUNTRY_LABEL: 'countryLabel',
    DISABLED: 'disabled',
    ENABLED: 'enabled',
    PREFERENCE: 'preference',
    MAXIMIZED_BASE_PATH: '/content/www/us/en/virtual-assistant/maximized/',
    VA_SERVLET_URL: '/content/data/globalelements/US/en/virtual-assistant/config.json',
    DEFAULT: 'default',
    US_EN: '/us/en/',
    VALID_PATH: 'VALID_PATH',
    B_UNIT: 'B_UNIT',
    VA_UID: 'VA_UID',
    VA_BANNER: 'VA_BANNER',
    CONTACT_SUPPORT: 'Contact Support',
    VA_BANNER_TEXT: 'vaBannerText',
    ALLOW_MAXIMIZATION: 'ALLOW_MAXIMIZATION',
    LS_CHAT_INTERACTED: 'chat-interacted',
    BANNER: 'banner',
    CLOSED: 'closed',
    WAP_USER_CONSENT: '_wap_user_consent',
    SUPPORT_PRODUCT_MAP: 'supportProductMap',
    ARTICLE_TITLE: 'articleTitle',
    ENABLE_COPILOT: 'enableCopilot',
    REGEX_COPILOT: 'REGEX_COPILOT',
    LOCALES: 'LOCALES',
    RESOURCES:'resources'
};

'use strict';
var intel = intel || {};
intel.chatUtility = (function () {

    function isUserFromPrc() {
        try {
            const rawCountryCode = getLocalStorageValue(intel.chatConstants.WAP_USER_CONSENT, 'country');
            const countryCode = typeof rawCountryCode === 'string' ? rawCountryCode.trim().toUpperCase() : '';
            // Added new check for country to be 2 character length
            return /^[A-Z]{2}$/.test(countryCode) && countryCode === 'CN';
        } catch (error) {
            return false;
        }
    }

    function botValidationOnInit() {
        let statusFlag = intel.chatConstants.DISABLED;
        if (intel.chatUtility.categoryHasConsent('functional') && intel.chatConstants.CID !== '') {
            statusFlag = intel.chatConstants.ENABLED;
        }
        return statusFlag;
    }

    function sanitizeHTML(str) {
        let temp = document.createElement('div');
        temp.textContent = str;
        return temp.innerHTML;
    }

    function getCookie(name) {
        let cookieArr = document.cookie.split(';');
        for (let i = 0; i < cookieArr.length; i++) {
            let cookiePair = cookieArr[i].split('=');
            if (name === cookiePair[0].trim()) {
                return decodeURIComponent(cookiePair[1]);
            }
        }
        return undefined;
    }

    function createCookie(name, value, minutes) {
        let expires = '';
        if (minutes) {
            let date = new Date();
            date.setTime(date.getTime() + (minutes * 60 * 1000));
            expires = '; expires=' + date.toGMTString();
        }
        document.cookie = name + '=' + encodeURIComponent(value) + expires + '; secure; path=/';
    }

    function isEmpty(item) {
        return (!item || item.length === 0);
    }

    function isNotEmpty(item) {
        return !isEmpty(item);
    }

    function setLocalStorageValue(lsKey, chatKey, chatValue) {
        let lsObject = window.localStorage.getItem(lsKey);
        let lsJsonObject;
        if (isNotEmpty(lsObject)) {
            lsJsonObject = JSON.parse(lsObject);
        } else {
            lsJsonObject = {};
        }
        lsJsonObject[chatKey] = chatValue;
        window.localStorage.setItem(lsKey, JSON.stringify(lsJsonObject));
    }

    function getLocalStorageValue(lsKey, chatKey) {
        let value = null;
        let lsObject = window.localStorage.getItem(lsKey);
        if (isNotEmpty(lsObject)) {
            let lsJsonObject = JSON.parse(lsObject);
            let item = lsJsonObject[chatKey];
            if (isNotEmpty(item)) {
                value = item;
            }
        }
        return value;
    }

    function generateUuid() {
        return ([1e7] + -1e3 + -4e3 + -8e3 + -1e11).replace(/[018]/g, c =>
            (c ^ crypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16)
        );
    }

    function categoryHasConsent(category) {
        let consent = localStorage.getItem('_wap_user_consent_str') || localStorage.getItem('_wap_default_user_consent_str');
        if (consent) {
            return consent.indexOf('all') >= 0 || consent.indexOf(category) >= 0;
        }
        return false;
    }

    function isMaximizedPage() {
        return currentPagePath.includes(intel.chatConstants.MAXIMIZED_BASE_PATH);
    }

    function validatePathJson(result, currentPagePath) {
        let validPath = false;
        if (typeof result !== intel.chatConstants.UNDEFINED && typeof result[intel.chatConstants.VALID_PATH] !== intel.chatConstants.UNDEFINED) {
            let dynamicPagesOptions = result[intel.chatConstants.VALID_PATH];
            let lenDynamicPages = dynamicPagesOptions.length;
            for (let i = 0; i < lenDynamicPages; i++) {
                let pathDynamic = dynamicPagesOptions[i];
                if (currentPagePath.includes(pathDynamic)) {
                    validPath = true;
                    break;
                }
            }
        }
        return validPath;
    }

    function doValidatePathWithRegex(currentPagePath, vaRegexOptions, vaOptionsSize) {
        for (let i = 0; i < vaOptionsSize; i++) {
            let vaElement = vaRegexOptions[i];
            let vaRegexPatterns = vaElement.PATTERNS;
            let patternCount = vaRegexPatterns.length;
            for (let j = 0; j < patternCount; j++) {
                let pattern = new RegExp(vaRegexPatterns[j]);
                let isFound = pattern.test(currentPagePath);
                if (isFound) {
                    return vaElement[intel.chatConstants.VA_UID];
                }
            }
        }
        return null;
    }

    function verifyVaRegex(vaRegexJson, currentPagePath) {
        let vaGuidTag;
        if (vaRegexJson.REGEX !== null) {
            let vaRegexOptions = vaRegexJson.REGEX;
            if (vaRegexOptions != null && vaRegexOptions.length > 0) {
                let vaOptionsSize = vaRegexOptions.length;
                vaGuidTag = doValidatePathWithRegex(currentPagePath, vaRegexOptions, vaOptionsSize);
            }
        }
        return vaGuidTag;
    }

    function getVaFromRegexJson(result) {
        let vaGuidTag;
        if (typeof result !== intel.chatConstants.UNDEFINED) {
            if (!currentPagePath.includes('.html')) {
                currentPagePath = currentPagePath + '.html';
            }
            vaGuidTag = verifyVaRegex(result, currentPagePath);
        }
        return vaGuidTag;
    }


    function setVaParameters(vaGuidTag, result) {
        for (let i = 0; i < result.REGEX.length; i++) {
            if (result.REGEX[i][intel.chatConstants.VA_UID] === vaGuidTag) {
                let botName = result.REGEX[i][intel.chatConstants.B_UNIT] + ' Virtual Assistant';
                chatConfigObj["virtualAssistantUid"] = result.REGEX[i][intel.chatConstants.VA_UID];
                chatConfigObj["virtualAssistantName"] = botName;
                cq_tms.wa_avaamo_project = "Avaamo-" + chatConfigObj.virtualAssistantName.replaceAll("Virtual Assistant", "").trim();
            }
        }
    }

    function extractBannerTextFromJson(result) {
        if (typeof result !== intel.chatConstants.UNDEFINED && typeof result[intel.chatConstants.VA_BANNER] !== intel.chatConstants.UNDEFINED) {
            let bannerJson;
            bannerJson = result[intel.chatConstants.VA_BANNER];
            if (typeof bannerJson !== intel.chatConstants.UNDEFINED && typeof bannerJson[chatConfigObj.virtualAssistantName] !== intel.chatConstants.UNDEFINED) {
                let specificBannerJson = bannerJson[chatConfigObj.virtualAssistantName];
                if (typeof specificBannerJson !== intel.chatConstants.UNDEFINED) {
                    if (typeof specificBannerJson[intel.chatConstants.DEFAULT] !== intel.chatConstants.UNDEFINED) {
                        chatConfigObj[intel.chatConstants.VA_BANNER_TEXT] = specificBannerJson[intel.chatConstants.DEFAULT];
                    }
                    let isValidSupportProductMap = isNotEmpty(chatContextObj.supportProductMap) && intel.chatConstants.NA !== chatContextObj.supportProductMap.toUpperCase();
                    if (chatConfigObj.virtualAssistantName.includes("GCS") && isValidSupportProductMap && chatContextObj[intel.chatConstants.APP] !== intel.chatConstants.CONTACT_SUPPORT) {
                        let jsonInfo = JSON.parse(chatContextObj.supportProductMap);
                        if (isNotEmpty(jsonInfo["level-1"])) {
                            let productId = jsonInfo["level-1"]["id"];
                            let bannerTextKey = "epm_" + productId;
                            if (typeof specificBannerJson[bannerTextKey] !== intel.chatConstants.UNDEFINED) {
                                chatConfigObj[intel.chatConstants.VA_BANNER_TEXT] = specificBannerJson[bannerTextKey];
                            }
                        }
                    }
                }
            }
        }
    }


    function setMaximizationFeatureFlag(result) {
        if (typeof result !== intel.chatConstants.UNDEFINED && typeof result[intel.chatConstants.ALLOW_MAXIMIZATION] !== intel.chatConstants.UNDEFINED) {
            let maximizationFeatureArray = result[intel.chatConstants.ALLOW_MAXIMIZATION];
            if (typeof maximizationFeatureArray !== intel.chatConstants.UNDEFINED && typeof maximizationFeatureArray[chatConfigObj.virtualAssistantName] !== intel.chatConstants.UNDEFINED) {
                maximizationFeatureFlag = maximizationFeatureArray[chatConfigObj.virtualAssistantName];
                if (typeof maximizationFeatureFlag !== intel.chatConstants.UNDEFINED) {
                    return maximizationFeatureFlag;
                }
            }
        }
    }

    function maximizeIconVisibility() {
        var maxIcon = document.getElementById("max_agent");
        maxIcon.style.display = (window.innerWidth >= 768) ? "inline-block" : "none";
    }

    /**
     * Builds complete regex patterns by combining regex templates with locale values
     * @param {Array} regexTemplates - Array of regex template strings containing {LOCALE} placeholder
     * @param {Array} locales - Array of locale strings to substitute into templates
     * @returns {Array} Array of complete regex pattern strings with locales substituted
     */

    function buildRegexPatternsWithLocales(regexTemplates, locales) {
        const fullPatterns = [];

        if (!regexTemplates || !Array.isArray(regexTemplates) || !locales || !Array.isArray(locales)) {
            return [];
        }

        locales.forEach(locale => {
            regexTemplates.forEach(template => {
                const fullPattern = template.replace('{LOCALE}', locale.replace('/', '\/'));
                fullPatterns.push(fullPattern);
            });
        });

        return fullPatterns;
    }

    /**
     * Checks if the current page path matches any of the valid path patterns
     * @param {Array} validPaths - Array of valid path strings to check against
     * @param {string} currentPath - The current page path to validate
     * @returns {boolean} True if current path contains any valid path, false otherwise
     */

    function isPageMatchingValidPath(validPaths, currentPath) {
        if (!validPaths || !Array.isArray(validPaths)) {
            return false;
        }

        for (let i = 0; i < validPaths.length; i++) {
            if (currentPath.includes(validPaths[i])) {
                return true;
            }
        }

        return false;
    }

    /**
     * Comprehensive page matching function that validates path against both valid paths and regex patterns
     * @param {Array} regexTemplates - Array of regex template strings with {LOCALE} placeholders
     * @param {Array} locales - Array of locale strings for pattern substitution
     * @param {Array} validPaths - Array of valid path strings for initial validation
     * @param {string} currentPath - The current page path to validate
     * @returns {boolean} True if path matches both valid paths and regex patterns, false otherwise
     */

    function isPageMatchingRegex(regexTemplates, locales, validPaths, currentPath) {
        const validPathMatched = isPageMatchingValidPath(validPaths, currentPath);

        if (!validPathMatched) {
            return false;
        }

        const regexPatterns = buildRegexPatternsWithLocales(regexTemplates, locales);

        if (!regexPatterns || regexPatterns.length === 0) {
            return false;
        }

        for (let i = 0; i < regexPatterns.length; i++) {
            try {
                let pattern = new RegExp(regexPatterns[i]);
                if (pattern.test(currentPath)) {
                    return true;
                }
            } catch (error) {
                console.error('Error with regex pattern:', regexPatterns[i], error);
            }
        }
        console.log('No pattern matched for path:', currentPath);

        return false;
    }

    return {
        botValidationOnInit: botValidationOnInit,
        getCookie: getCookie,
        createCookie: createCookie,
        setLocalStorageValue: setLocalStorageValue,
        getLocalStorageValue: getLocalStorageValue,
        isEmpty: isEmpty,
        isNotEmpty: isNotEmpty,
        sanitizeHTML: sanitizeHTML,
        generateUuid: generateUuid,
        categoryHasConsent: categoryHasConsent,
        isMaximizedPage: isMaximizedPage,
        extractBannerTextFromJson: extractBannerTextFromJson,
        setMaximizationFeatureFlag: setMaximizationFeatureFlag,
        maximizeIconVisibility: maximizeIconVisibility,
        isPageMatchingRegex: isPageMatchingRegex,
        isUserFromPrc: isUserFromPrc
    }
})();

'use strict';
var intel = intel || {};
let isNewUser = false;
intel.chatBotParameters = (function () {

    function setCountryLabel() {
        const countryCode = intel.chatUtility.getLocalStorageValue(intel.chatConstants.WAP_USER_CONSENT, "country");
        if (typeof chatContextObj !== intel.chatConstants.UNDEFINED && (countryCode !== null && countryCode.trim() !== intel.chatConstants.EMPTY)) {
            const regionNamesInEnglish = new Intl.DisplayNames(['en'], {type: 'region'});
            chatContextObj[intel.chatConstants.COUNTRY_LABEL] = regionNamesInEnglish.of(countryCode);
        } else {
            chatContextObj[intel.chatConstants.COUNTRY_LABEL] = intel.chatConstants.NA;
        }
    }
    function setArticleTitle() {
        const articleTitle = document.querySelector('meta[name="title"]') !== null ? document.querySelector('meta[name="title"]').getAttribute('content') : null;
        if (typeof chatContextObj !== intel.chatConstants.UNDEFINED && articleTitle!== null) {
            chatContextObj[intel.chatConstants.ARTICLE_TITLE] = encodeURIComponent(articleTitle);
        } else {
            chatContextObj[intel.chatConstants.ARTICLE_TITLE] = intel.chatConstants.NA;
        }
    }




    function isLoggedIn() {
        return location.protocol === 'https:' && window.isLoggedin === true;
    }

    return {

        isLoggedIn: isLoggedIn,

        setArticleTitle: setArticleTitle,
        setCountryLabel: setCountryLabel

    }
})();

'use strict';
var intel = intel || {};

/**
 * Intel ChatBot Loader Module - Handles dynamic loading of chatbot assets (CSS and JS files)
 */

intel.chatBotLoader = (function() {

    /**
     * Main function to load chatbot assets including CSS and JavaScript files
     * @param {Object} config - Configuration object containing resources array
     * @param {Array} config.resources - Array of resource objects with type, url, and name properties
     * @returns {Promise} Promise that resolves when all assets are loaded
     */

    function loadChatBotAssets(config = {}) {
        const cssResources = config.resources.filter(resource => resource.type === 'css');
        const jsResources = config.resources.filter(resource => resource.type === 'js');

        cssResources.forEach((resource, index) => {
            if (resource.url && !document.querySelector(`link[href="${resource.url}"]`)) {
                const link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = resource.url;
                document.head.appendChild(link);
            }
        });

        // Create hidden username input if it doesn't exist (required for chatbot functionality)
        if (!document.getElementById('username')) {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.id = 'username';
            hiddenInput.value = 'Fanta';
            document.body.appendChild(hiddenInput);
        }

        // Create webchat container div if it doesn't exist (main chatbot UI container)
        if (!document.getElementById('webchat')) {
            const webchatDiv = document.createElement('div');
            webchatDiv.role = 'main';
            webchatDiv.id = 'webchat';
            document.body.appendChild(webchatDiv);
        }

        return loadScriptsSequentially(jsResources, config);
    }

    /**
     * Loads JavaScript files one by one in sequence to maintain dependency order
     * @param {Array} jsResources - Array of JavaScript resource objects
     * @param {Object} config - Configuration object to pass through the promise chain
     * @returns {Promise} Promise that resolves when all scripts are loaded successfully
     */

    function loadScriptsSequentially(jsResources, config) {
        return new Promise((resolve, reject) => {
            let currentIndex = 0;

            function loadNextScript() {
                if (currentIndex >= jsResources.length) {
                    resolve(config);
                    return;
                }

                const resource = jsResources[currentIndex];
                const scriptSrc = resource.url;

                if (document.querySelector(`script[src="${scriptSrc}"]`)) {
                    currentIndex++;
                    loadNextScript();
                    return;
                }

                const script = document.createElement('script');
                script.type = 'text/javascript';
                script.src = scriptSrc;

                script.onload = () => {
                    if (currentIndex === jsResources.length - 1) {
                        setTimeout(() => {
                            const event = new CustomEvent('initializeCopilot', {
                                detail: {
                                    config: config,
                                    loadedResources: jsResources
                                },
                                bubbles: true,
                                cancelable: true
                            });
                            document.dispatchEvent(event);
                        }, 100);
                    }

                    currentIndex++;
                    loadNextScript();
                };

                script.onerror = () => {
                    console.error('Failed to load script:', scriptSrc);
                    reject(new Error('Failed to load script'));
                };

                document.head.appendChild(script);
            }

            loadNextScript();
        });
    }

    /**
     * Public initialization method - entry point for the chatbot loader
     * @param {Object} config - Configuration object containing resources
     * @returns {Promise} Promise that resolves with the original config or rejects with error
     */

    function init(config = {}) {
        return loadChatBotAssets(config).catch(error => {
            console.error('Error loading ChatBot:', error);
            throw error;
        });
    }

    return {
        init: init,
        loadAssets: loadChatBotAssets
    };
})();
'use strict';
var intel = intel || {};
var wap_tms = wap_tms || {};
var cq_tms = cq_tms || {};
let currentPagePath = window.location.pathname;
let maximizationFeatureFlag;
const partnerAllianceChatSupportPath = /^\/content\/www\/[^/]+\/[^/]+\/partner-alliance\/chat-support\.html$/;


/**
 * Loads Ask Intel ChatBot assets using the chatbot loader
 * @param {Object} configData - Configuration data
 */

function loadIntelChatBotAssets(configData = {}) {
    if (typeof intel.chatBotLoader !== 'undefined') {
        intel.chatBotLoader.init(configData).catch(error => {
            console.error('Error loading Intel ChatBot assets:', error);
        });
    } else {
        console.error('Intel ChatBot loader not available. Make sure chatbot-loader.js is loaded first.');
    }
}


function isCurrentUserFromPrc() {
    return intel.chatUtility && typeof intel.chatUtility.isUserFromPrc === 'function' &&
        intel.chatUtility.isUserFromPrc();
}

function isPartnerChatSupportPage(path) {
    return path.endsWith('/partner-alliance/chat-support.html');
}

function isPartnerAllianceChatSupportPage(path) {
    return partnerAllianceChatSupportPath.test(path);
}

function isPartnerCopilotEnabled() {
    const settings = window?.INTEL?.SupportSettings;
    const flag = settings ? settings['partnerPhoneSupportLinks.enableChatSupportForIPA'] : null;
    return typeof flag === 'string' && flag.toLowerCase() === 'yes';
}

function isConfiguredCopilotEnabled(config) {
    return config[intel.chatConstants.ENABLE_COPILOT] === 'Y';
}

function isPageConfiguredForCopilot(config) {
    return intel.chatUtility.isPageMatchingRegex(
        config[intel.chatConstants.REGEX_COPILOT],
        config[intel.chatConstants.LOCALES],
        config[intel.chatConstants.VALID_PATH],
        currentPagePath
    );
}

function shouldLoadCopilotForCurrentPage(config) {
    if (isPartnerChatSupportPage(currentPagePath)) {
        return isPartnerCopilotEnabled();
    }
    return isPageConfiguredForCopilot(config);
}

function getChatBotConfig(config) {
    return {resources: config[intel.chatConstants.RESOURCES]};
}

function loadCopilotForCurrentPage(config) {
    if (!shouldLoadCopilotForCurrentPage(config)) {
        return;
    }

    if (isPartnerAllianceChatSupportPage(currentPagePath)) {
        document.documentElement.classList.add('partner-alliance-chat');
    }
    intel.chatBotParameters.setCountryLabel();
    intel.chatBotParameters.setArticleTitle();

    const chatBotConfig = getChatBotConfig(config);
    if (chatBotConfig.resources && Array.isArray(chatBotConfig.resources)) {
        loadIntelChatBotAssets(chatBotConfig);
    } else {
        console.error('Missing resources array in servlet response');
    }
}

function parseCopilotConfig(response) {
    if (!response.ok) {
        throw new Error(response.status);
    }
    return response.json();
}

function initializeConfiguredCopilot(config) {
    if (isConfiguredCopilotEnabled(config)) {
        loadCopilotForCurrentPage(config);
    }
}

function logCopilotConfigError(error) {
    console.error('Error fetching config json:', error);
}

function initializeAskIntel() {
    if (isCurrentUserFromPrc()) {
        return;
    }

    fetch(intel.chatConstants.VA_SERVLET_URL)
        .then(parseCopilotConfig)
        .then(initializeConfiguredCopilot)
        .catch(logCopilotConfigError);
}

initializeAskIntel();

